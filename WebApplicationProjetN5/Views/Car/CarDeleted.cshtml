@section Styles {
    <link rel="stylesheet" href="~/css/carDeleted.css" />
}

@model WebApplicationProjetN5.Models.ViewModels.CarViewModel
<form asp-controller="Car" asp-action="Index" method="post">
    <div class="main-block">
        <div class="space-block">
            <h1 class="space-title">Merci!</h1>
            <p>@Model.Car.CarModel.Name @Model.Car.CarFinish.Name  a été supprimée avec succès.</p>
        </div>
        <button type="submit" class="bt-publish">Retour à l'accueil</button>
    </div>
</form>