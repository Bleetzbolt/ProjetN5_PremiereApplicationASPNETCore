@model WebApplicationProjetN5.Models.ViewModels.CarViewModel
@section Styles {
    <link rel="stylesheet" href="~/css/formNewCar.css" />
}

<div class="page-block">
    <div>
        <p>Ajouter une voiture</p>
    </div>
    
    <div>
        <p> Tous les champs sont obligatoires </p>
    </div>
    
    <div class="main-block">
        <form asp-controller="Car" asp-action="Create" method="post" enctype="multipart/form-data">
            <!-- <div asp-validation-summary="All" class="validation-errors"></div> -->
            <div class="space-field-center">
                <div class="space-field">
                    <label asp-for="Car.PurchasePrice" class="space-lbl">
                        Prix d'achat
                    </label>
                    <br />
                    <input asp-for="Car.PurchasePrice" type="text" inputmode="decimal" class="form-field" />
                    <span asp-validation-for="Car.PurchasePrice" class="text-danger"></span>

                </div>

                <div class="space-field">

                    <p class="space-lbl">Date de mise en vente</p>


                    <input asp-for="Car.SaleDate"
                           type="date"
                           onkeydown="return false;"
                           onpaste="return false;"
                           class="form-field" />
                </div>

                <div class="space-field">
                    <label class="space-lbl" for="Year">Année</label>
                    <br />
                    <select asp-for="Car.ReleasedYear" class="form-field">
                        <option value="">-- Sélectionner une année --</option>
                        @for (int year = 1990; year <= DateTime.Now.Year; year++)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                    <span asp-validation-for="Car.ReleasedYear" class="text-danger"></span>
                </div>

                <div class="space-field">
                    <label class="space-lbl">Marque</label>
                    <br />
                    <select asp-for="Car.CarModel.Brand.Name"
                            asp-items="Model.SelBrandVMs"
                            id="CarCarModelBrandName"
                            class="form-field">
                        <option value="">-- Choisir une marque --</option>
                        <option value="__custom__Brand">+ Saisir une marque...</option>
                    </select>
                    <span asp-validation-for="Car.CarModel.Brand.Name" class="text-danger"></span>

                    <input type="text"
                           name="CustomBrand"
                           id="CustomBrand"
                           class="form-field"
                           placeholder="Saisir le nom de la marque"
                           style="display:none;" />
                </div>
               
                <div class="space-field">
                    <label class="space-lbl">Modèle</label>
                    <br />
                    <select asp-for="Car.CarModel.Name"
                            asp-items="Model.SelCarModelVMs"
                            id="CarCarModelName"
                            class="form-field">
                        <option value="">-- Choisir un modèle --</option>
                        <option value="__custom__CarModel">+ Saisir un modèle...</option>
                    </select>
                    <span asp-validation-for="Car.CarModel.Name" class="text-danger"></span>
                    <input type="text"
                           name="CustomCarModel"
                           id="CustomCarModel"
                           class="form-field"
                           placeholder="Saisir le nom du modèle"
                           style="display:none;" />
                </div>
                
                <div class="space-field">
                    <label class="space-lbl">Finition</label>
                    <br />
                    <select asp-for="Car.CarFinish.Name"
                            asp-items="Model.SelCarFinishVMs"
                            id="CarCarFinishName"
                            class="form-field">
                        <option value="">-- Choisir une finition --</option>
                        <option value="__custom__CarFinish">+ Saisir une finition...</option>
                    </select>
                    <span asp-validation-for="Car.CarFinish.Name" class="text-danger"></span>
                    <input type="text"
                           name="CustomCarFinish"
                           id="CustomCarFinish"
                           class="form-field"
                           placeholder="Saisir le nom de la finition"
                           style="display:none;" />
                </div>

                <div class="space-pic">
                    <div class="photo-upload">
                        <div>
                            <input type="file"
                                   id="photo"
                                   name="photo"
                                   accept="image/*"
                                   hidden />

                            <label for="photo" class="bt-add-photo">+</label>
                        </div>

                        <span id="photo-name" class="space-text-pic">Ajoutez une image</span>
                        <span asp-validation-for="Car.Photo" class="text-danger"></span>
                    </div>
                </div>

                <div class="title-repair">
                    <p>Réparations</p>
                </div>
                
                <div class="block-repair" id="reparations-container">

                   

                    <div class="reparation-item">
                        <!--
                        <div>
                            <label>Description:</label>
                            <br />
                            <input type="text"
                                   name="Car.Reparations[0].Description" />
                            <br />
                            <label>Coût (€)   :</label>
                            <br />
                            <input type="number"
                                   name="Car.Reparations[0].Cost"
                                   min="0"
                                   step="0.01" />
                        </div>

                        <div class="space-bt-del">
                            <button type="button" class="bt-publish"
                                    onclick="supprimerReparation(this)">
                                Supprimer
                            </button>
                        </div>
                        -->
                    </div>
                </div>
            </div>

            <div class="space-bt-add">
                <button type="button" onclick="ajouterReparation()" class="bt-publish">
                    Ajouter une réparation
                </button>
            </div>

            <div class="space-bt">
                <button type="submit" class="bt-publish">Publier</button>
            </div>

        </form>
    </div>
</div>

<script>
    const brandSelect = document.getElementById("CarCarModelBrandName");
    const customBrandInput = document.getElementById("CustomBrand");
    const carModelSelect = document.getElementById("CarCarModelName");
    const customCarModelInput = document.getElementById("CustomCarModel");
    const carFinishSelect = document.getElementById("CarCarFinishName");
    const customCarFinishInput = document.getElementById("CustomCarFinish");

    function addCustomCarModelOption() {
        const option = document.createElement("option");
        option.value = "__custom__CarModel";
        option.textContent = "+ Saisir un modèle...";
        carModelSelect.appendChild(option);
    }

    function addCustomCarFinishOption() {
        const option = new Option(
            "+ Saisir une finition...",
            "__custom__CarFinish"
        );

        carFinishSelect.add(option);
    }

    brandSelect.addEventListener("change", async function () {
        const brandName = this.value;

        const isCustomBrand = this.value === "__custom__Brand";

        customBrandInput.style.display = isCustomBrand ? "block" : "none";

        carModelSelect.replaceChildren(new Option("-- Choisir un modèle --", ""));

        customCarModelInput.style.display = "none";
        customCarModelInput.value = "";

        if (!brandName || brandName === "__custom__Brand") {
            addCustomCarModelOption();
            return;
        }

        try {
            const response = await fetch(`/Car/GetModelsByBrand?brandName=${encodeURIComponent(brandName)}`);

            if (!response.ok) {
                throw new Error("Erreur lors du chargement des modèles.");
            }

            const carModels = await response.json();

            carModels.forEach(carModel => {
                carModelSelect.add(new Option(carModel.name, carModel.name));
            });

            addCustomCarModelOption();
        }
        catch (error) {
            console.error(error);
            addCustomCarModelOption();
        }
    });

    carModelSelect.addEventListener("change", async function () {
        const carModelName = this.value;

        // Afficher ou masquer la saisie libre du modèle.
        const isCustom = carModelName === "__custom__CarModel";

        customCarModelInput.style.display = isCustom ? "block" : "none";

        if (isCustom) {
            customCarModelInput.focus();
        } else {
            customCarModelInput.value = "";
        }

        // Réinitialiser la liste des finitions.
        carFinishSelect.replaceChildren(
            new Option("-- Choisir une finition --", "")
        );

        customCarFinishInput.style.display = "none";
        customCarFinishInput.value = "";

        // Si aucun modèle n'est choisi, ou si l'utilisateur saisit
        // un nouveau modèle, ne pas charger les finitions existantes.
        if (!carModelName || isCustom) {
            addCustomCarFinishOption();
            return;
        }

        try {
            const response = await fetch(
                `/Car/GetCarFinishesByModel?carModelName=${encodeURIComponent(carModelName)}`
            );

            if (!response.ok) {
                throw new Error("Erreur lors du chargement des finitions.");
            }

            const carFinishes = await response.json();

            carFinishes.forEach(carFinish => {
                carFinishSelect.add(
                    new Option(carFinish.name, carFinish.name)
                );
            });

            addCustomCarFinishOption();
        } catch (error) {
            console.error(error);
            addCustomCarFinishOption();
        }
    });

    carFinishSelect.addEventListener("change", function () {
        const isCustomCarFinish = this.value === "__custom__CarFinish";
        customCarFinishInput.style.display = isCustomCarFinish ? "block" : "none";
        if (isCustomCarFinish) {
            customCarFinishInput.focus();
        } else {
            customCarFinishInput.value = "";
        }
    });

    // Gestion de l'affichage du nom du fichier sélectionné pour l'image
    const photoInput = document.getElementById("photo");
    const photoName = document.getElementById("photo-name");

    photoInput.addEventListener("change", function () {
        if (this.files.length > 0) {
            photoName.textContent = this.files[0].name;
                    } else {
            photoName.textContent = "Ajouter une image";
        }
    });


    //Gestion d'ajout/suppression de réparations
    let indexReparation = 1;

    function ajouterReparation() {
        const container =
            document.getElementById("reparations-container");

        const div = document.createElement("div");
        div.className = "reparation-item";

        div.innerHTML = `

                                                                                 <div>
                                                                                    <label>Description</label>
                                                                                    <br />
                                                                                    <input type="text"
                                                                                           name="Car.Reparations[${indexReparation}].Description" />
                                                                                    <br />
                                                                                    <label>Coût   :(€)</label>
                                                                                    <br />
                                                                                    <input type="number"
                                                                                           name="Car.Reparations[${indexReparation}].Cost"
                                                                                           min="0"
                                                                                           step="0.01" />
                                                                                 </div>

                                                                                <div class="space-bt-del">
                                                                                    <button type="button" class="bt-publish"
                                                                                            onclick="supprimerReparation(this)">
                                                                                        Supprimer
                                                                                    </button>
                                                                                </div>

                                                                                `;

        container.appendChild(div);
        indexReparation++;
    }

    function supprimerReparation(button) {
        button.closest(".reparation-item").remove();
    }

</script>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    
}

