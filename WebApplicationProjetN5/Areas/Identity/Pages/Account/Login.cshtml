@page
@model LoginModel
@section Styles {
    <link rel="stylesheet" href="~/css/Login.css" />
    
    }
    @{
        ViewData["Title"] = "Express Voiture";
    }

    <h1 class="login-title">@ViewData["Title"]</h1>
<div class="main-block">
    <div>
        <div >
            <section>
                <form id="account" method="post">

                    
                    <div asp-validation-summary="ModelOnly" class="form-tb-mail-password" role="alert"></div>
                    
                    <div class="space-mailpwd">
                        <label asp-for="Input.Email" class="space-lbl">Adresse email</label>
                        <input asp-for="Input.Email" class="form-tb-mail-password" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="form-tb-mail-password"></span>
                    </div>
                   
                    <div class="space-mailpwd">
                        <label asp-for="Input.Password" class="space-lbl">Password</label>
                        <input asp-for="Input.Password" class="form-tb-mail-password" autocomplete="current-password" aria-required="true" placeholder="password" />
                        <span asp-validation-for="Input.Password" class="form-tb-mail-password" ></span>
                    </div>
                    
                    <div class="space-bt">
                    <div >
                        <button id="login-submit" type="submit" class="btn_login">Se connecter</button>
                    </div>
                    </div>
                </form>
            </section>
        </div>

    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
